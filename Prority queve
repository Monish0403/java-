#include <stdio.h>
#define SIZE 5

// Structure to store an element and its priority
struct Element {
    int data;
    int priority;
};

struct Element pq[SIZE];
int count = 0;

// Check if the priority queue is full
int isFull() {
    return count == SIZE;
}

// Check if the priority queue is empty
int isEmpty() {
    return count == 0;
}

