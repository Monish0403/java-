Authentication Flow:<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CampusConnect | Administration Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-color: #0f172a;
            --glass-bg: rgba(30, 41, 59, 0.7);
            --glass-border: rgba(255, 255, 255, 0.1);
            --primary-teal: #14b8a6;
            --primary-blue: #3b82f6;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            background-image: 
                radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(20, 184, 166, 0.15) 0px, transparent 50%);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
        }

        /* Glassmorphism Container */
        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 40px;
            width: 100%;
            max-width: 900px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            transition: all 0.4s ease;
        }

        .hidden {
            display: none !important;
        }

        /* Login Screen */
        .login-wrapper {
            max-width: 450px;
            margin: 0 auto;
            text-align: center;
        }

        .logo-area h1 {
            font-size: 28px;
            font-weight: 700;
            background: linear-gradient(to right, var(--primary-teal), var(--primary-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .logo-area p {
            color: var(--text-muted);
            margin-bottom: 30px;
            font-size: 14px;
        }

        .role-selector {
            margin-bottom: 25px;
            text-align: left;
        }

        .role-selector label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-muted);
        }

        select {
            width: 100%;
            padding: 12px 15px;
            border-radius: 12px;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            font-size: 15px;
            outline: none;
            transition: border-color 0.3s;
        }

        select:focus {
            border-color: var(--primary-teal);
        }

        .google-btn {
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            background: white;
            color: #333;
            border: none;
            font-weight: 600;
            font-size: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .google-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .google-btn img {
            width: 20px;
            height: 20px;
        }

        /* Dashboards */
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--glass-border);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-teal), var(--primary-blue));
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 20px;
            font-weight: 600;
        }

        .user-info h2 {
            font-size: 18px;
        }
        
        .user-info p {
            font-size: 13px;
            color: var(--text-muted);
        }

        .logout-btn {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.2);
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s;
        }

        .logout-btn:hover {
            background: rgba(239, 68, 68, 0.2);
        }

        /* Grid Layouts for Data */
        .data-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .card {
            background: rgba(15, 23, 42, 0.4);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 20px;
        }

        .card h3 {
            font-size: 15px;
            color: var(--text-muted);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card .value {
            font-size: 28px;
            font-weight: 600;
        }

        /* Task List (Facilitator) */
        .task-list {
            list-style: none;
            margin-top: 20px;
        }

        .task-item {
            background: rgba(15, 23, 42, 0.4);
            border: 1px solid var(--glass-border);
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pending { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
        .status-done { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    </style>
</head>
<body>

    <!-- App Container -->
    <div class="glass-panel" id="app-container">
        
        <!-- 1. LOGIN SCREEN -->
        <div id="login-view" class="login-wrapper">
            <div class="logo-area">
                <h1>CampusConnect</h1>
                <p>Secure Administration & Facility Portal</p>
            </div>

            <div class="role-selector">
                <label for="userRole">Select your access role:</label>
                <select id="userRole">
                    <option value="student">🎓 College Student</option>
                    <option value="facilitator">🛠️ D-Group Facilitator (Staff)</option>
                </select>
            </div>

            <button class="google-btn" id="loginBtn" onclick="handleGoogleLogin()">
                <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" alt="Google Logo">
                Sign in with Google
            </button>
        </div>

        <!-- 2. STUDENT DASHBOARD -->
        <div id="student-view" class="hidden">
            <div class="dashboard-header">
                <div class="user-profile">
                    <div class="avatar">M</div>
                    <div class="user-info">
                        <h2 id="student-name">Monish M N</h2>
                        <p id="student-email">monish.mn@university.edu</p>
                    </div>
                </div>
                <button class="logout-btn" onclick="handleLogout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </div>

            <h3 style="margin-bottom: 20px; color: var(--primary-teal);">Academic Overview</h3>
            <div class="data-grid">
                <div class="card">
                    <h3><i class="fas fa-calendar-check"></i> Attendance</h3>
                    <div class="value">92%</div>
                </div>
                <div class="card">
                    <h3><i class="fas fa-graduation-cap"></i> Current CGPA</h3>
                    <div class="value">9.6</div>
                </div>
                <div class="card">
                    <h3><i class="fas fa-book"></i> Upcoming Exam</h3>
                    <div class="value" style="font-size: 18px; margin-top: 10px;">Advanced Java - Oct 25</div>
                </div>
            </div>
        </div>

        <!-- 3. D-GROUP FACILITATOR DASHBOARD -->
        <div id="facilitator-view" class="hidden">
            <div class="dashboard-header">
                <div class="user-profile">
                    <div class="avatar" style="background: linear-gradient(135deg, #f59e0b, #ef4444);">S</div>
                    <div class="user-info">
                        <h2>Campus Staff (D-Group)</h2>
                        <p id="staff-email">maintenance@university.edu</p>
                    </div>
                </div>
                <button class="logout-btn" onclick="handleLogout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
            </div>

            <h3 style="margin-bottom: 20px; color: var(--primary-blue);">Today's Facility Tasks</h3>
            <ul class="task-list">
                <li class="task-item">
                    <div>
                        <strong>CS Department Lab 1</strong>
                        <p style="font-size: 13px; color: var(--text-muted);">Routine cleaning and system checks</p>
                    </div>
                    <span class="status-badge status-pending">Pending</span>
                </li>
                <li class="task-item">
                    <div>
                        <strong>Hostel Block B - Plumbing</strong>
                        <p style="font-size: 13px; color: var(--text-muted);">Fix leaking pipe on 2nd floor</p>
                    </div>
                    <span class="status-badge status-pending">Pending</span>
                </li>
                <li class="task-item">
                    <div>
                        <strong>Main Auditorium</strong>
                        <p style="font-size: 13px; color: var(--text-muted);">Setup chairs for guest lecture</p>
                    </div>
                    <span class="status-badge status-done">Completed</span>
                </li>
            </ul>
        </div>

    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // DOM Elements
        const loginView = document.getElementById('login-view');
        const studentView = document.getElementById('student-view');
        const facilitatorView = document.getElementById('facilitator-view');
        const loginBtn = document.getElementById('loginBtn');
        const roleSelect = document.getElementById('userRole');

        // Function to simulate Google OAuth Login
        function handleGoogleLogin() {
            const selectedRole = roleSelect.value;
            
            // UI Feedback during "Auth"
            const originalText = loginBtn.innerHTML;
            loginBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Authenticating...';
            loginBtn.disabled = true;

            // Simulate network request/OAuth popup delay (1.5 seconds)
            setTimeout(() => {
                // Hide Login Screen
                loginView.classList.add('hidden');

                // Route to correct dashboard based on role selection
                if (selectedRole === 'student') {
                    studentView.classList.remove('hidden');
                } else if (selectedRole === 'facilitator') {
                    facilitatorView.classList.remove('hidden');
                }

                // Reset button state for next time
                loginBtn.innerHTML = originalText;
                loginBtn.disabled = false;
            }, 1500);
        }

        // Function to handle Logout
        function handleLogout() {
            // Hide all dashboards
            studentView.classList.add('hidden');
            facilitatorView.classList.add('hidden');
            
            // Show login screen
            loginView.classList.remove('hidden');
            
            // Optional: clear any session storage/tokens here in a real app
            console.log("User logged out successfully.");
        }
    </script>
</body>
</html>
